@startuml market-sentinel-detection-flow
!include ../../sellStocks/diagrams/sell-style.puml
title Proposed Market Sentinel · one polling cycle
participant "Scheduler\ninbound adapter" as S
participant "Detection service\nvia inbound port" as D
participant "Query adapter\nvia query port" as Q
participant "Quote adapter\nvia existing port" as P
participant "Console adapter\nvia notification port" as N
S -> D : detectBuySignals()
D -> Q : distinct active tickers
Q --> D : ticker set
D -> P : fetchStockPrice(tickers)
note over D, P
  Default: sequential single-ticker calls
  Provider failure aborts collection
end note
P --> D : observed quotes
loop each observed ticker
  D -> Q : active alerts where threshold >= price
  Q --> D : matching projections
  loop each match
    D -> N : signal + observation time
  end
end
note over D, N
  Query methods read; notification has effects
  Level 1 may repeat signals in later cycles
end note
@enduml
