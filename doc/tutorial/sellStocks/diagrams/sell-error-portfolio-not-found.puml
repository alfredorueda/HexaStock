@startuml sell-error-portfolio-not-found
!include sell-style.puml
title <size:12><color:#087F8C>08 / ERROR PATH · 404</color></size>\nStop when the aggregate is absent

participant "REST / Spring MVC" as C
participant "Application service" as S
participant "PortfolioPort" as P
participant "Exception advice" as E #FFF5DF
C -> S : sellStock(id, AAPL, 12)
activate S
S -> P : getPortfolioById(id)
P --> S : Optional.empty()
S --[#B64D4D]> C : PortfolioNotFoundException
deactivate S
C -> E : resolve exception
E --> C : 404 · Portfolio Not Found\n"Portfolio not found with id: ..."
note over S, E
  An application-level retrieval failure.
  No quote request, domain sale or persistence write.
end note
@enduml
