@startuml sell-application-service
!include sell-style.puml
title <size:12><color:#087F8C>05 / APPLICATION</color></size>\nCoordinate one complete sale

participant "Service" as S
participant "PortfolioPort" as P
participant "Price provider\nport" as Q
participant "Portfolio\naggregate" as A #E6F3F1
participant "TransactionPort" as T
activate S
S -> P : 1  getPortfolioById(id)
P --> S : portfolio
S -> Q : 2  fetchStockPrice(ticker)
Q --> S : StockPrice · Price 150.00
S -> A : 3  sell(AAPL, 12, price)
activate A
A --> S : SellResult
deactivate A
S -> P : 4  savePortfolio(portfolio)
P --> S : saved in current transaction
S -> S : Transaction.createSale(...)
S -> T : 5  save(transaction)
T --> S : saved in current transaction
deactivate S
note over S, T
  The transaction commits after the advised method returns.
  FIFO and cash arithmetic stay inside the domain.
end note
@enduml
