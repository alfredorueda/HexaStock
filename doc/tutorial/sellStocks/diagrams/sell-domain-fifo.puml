@startuml sell-domain-fifo
!include sell-style.puml
title <size:12><color:#087F8C>03 / DOMAIN</color></size>\nOne sale, two FIFO steps

top to bottom direction
rectangle "<b>START · 15 shares</b>\nLot 1: 10 × 100.00   |   Lot 2: 5 × 120.00\nSell 12 at 150.00" as Start #EAF3F9
rectangle "<b>1  Check availability</b>\n15 ≥ 12 · proceed before mutating lots\nProceeds = 12 × 150.00 = 1800.00" as Check
rectangle "<b>2  Consume Lot 1</b>\nTake min(10, 12) = 10\nCost basis +1000.00 · still to sell: 2\nLot empty → iterator.remove()" as First #E6F3F1
rectangle "<b>3  Consume Lot 2</b>\nTake min(5, 2) = 2\nCost basis +240.00 · still to sell: 0\nKeep Lot 2 with 3 shares" as Second #E6F3F1
rectangle "<b>RESULT · US-07.FIFO-2</b>\nProceeds 1800.00 · cost basis 1240.00\nProfit 560.00 · shares remaining 3\nPortfolio credits cash by 1800.00" as Result #FFF5DF
Start -down-> Check
Check -down-> First
First -down-> Second
Second -down-> Result
@enduml
